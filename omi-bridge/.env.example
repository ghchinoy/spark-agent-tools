# Copy to .env and edit. scripts/deploy.sh sources this file.
# .env is gitignored — never commit real secrets.

# Google Cloud target for deployment
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
SERVICE_NAME=omi-mcp-bridge

# HMAC key used to sign/verify stateless JWT access tokens.
# Generate a strong one: openssl rand -hex 32
# If left blank, scripts/deploy.sh generates a random key for you.
JWT_SIGNING_KEY=

# Your personal Omi MCP API key (generated in Omi app -> Settings -> Developer -> MCP)
# Looks like: omi_mcp_...
OMI_MCP_API_KEY=omi_mcp_your_key_here

# Optional: Omi API base URL (defaults to https://api.omi.me if omitted)
# OMI_API_BASE_URL=https://api.omi.me

# Optional: Passphrase required during OAuth consent on /authorize
# OMI_BRIDGE_PASSPHRASE=your_secret_passphrase
